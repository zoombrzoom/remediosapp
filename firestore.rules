rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Dados compartilhados do app de saúde - qualquer usuário autenticado pode ler/escrever
    match /users/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Regras existentes para artifacts
    match /artifacts/{appId}/users/{userId} {
      match /folders/{folderId} {
        allow read, write: if isAuthenticated();
      }
      match /exams/{examId} {
        allow read, write: if isAuthenticated();
        match /fileChunks/{chunkId} {
          allow read, write: if isAuthenticated();
        }
      }
      match /settings/{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /artifacts/{appId}/public/data/shares/{shareId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['userId', 'createdAt', 'expiresAt']) &&
                       request.resource.data.userId is string &&
                       request.resource.data.userId.size() > 0 &&
                       request.resource.data.expiresAt is timestamp &&
                       request.resource.data.expiresAt.toMillis() > request.time.toMillis();
      allow update, delete: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
